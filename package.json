{
  "name": "rivo-support",
  "version": "2.0.0",
  "description": "Rivo Store — support desk: email OTP login, store orders, Roblox verification, ticket chat. Runs on Vercel.",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "node src/scripts/setup.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "staff:add": "node src/scripts/add-staff.js"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "helmet": "8.0.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.15",
    "pg": "8.13.1"
  }
}
