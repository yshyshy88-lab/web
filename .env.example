# ═══════════════════════════════════════════════════════════
#  الأسرار فقط. باقي الإعدادات في ملف config.js
#  على Vercel: Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# يُولَّد تلقائيًا بالأمر: npm run setup
SESSION_SECRET=

# Postgres — من Vercel → Storage، أو من neon.tech مجانًا
DATABASE_URL=

# البريد (إرسال كود الدخول)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rivo Store <support@rivostore.com>

# ربط متجر رمز الرقمية
STORE_WEBHOOK_SECRET=
STORE_WEBHOOK_SIGNATURE_HEADER=
STORE_WEBHOOK_PATH_TOKEN=
STORE_API_BASE=
STORE_API_KEY=

# هوية المتجر (اختياري — القيم الافتراضية في config.js)
STORE_NAME=Rivo Store
PUBLIC_URL=http://localhost:3000
SHOP_URL=
